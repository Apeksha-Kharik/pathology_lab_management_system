PORT=5000
NODE_ENV=development
MONGO_URI=
# Optional: maximum time to discover a MongoDB server (milliseconds).
MONGO_CONNECTION_TIMEOUT_MS=30000
JWT_SECRET=

# Razorpay: begin with Test Mode keys, then replace with Live Mode keys after verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Comma-separated frontend origins allowed by CORS (no trailing slash).
FRONTEND_URL=https://pathology-lab-frontend-fywm.onrender.com

# Required for real Gmail SMTP email delivery.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=
EMAIL_FROM=your_email@gmail.com

# In local development only, show the OTP in the UI if email delivery fails.
# This fallback is always disabled when NODE_ENV=production.
ALLOW_DEV_OTP=true

# Required for WhatsApp notifications after booking/payment/report events.
# Use Meta WhatsApp Cloud API credentials.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Razorpay TEST MODE only. Set actual values in ignored .env or Render.
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Recommended approved utility templates for notifications outside WhatsApp's
# customer-service window. Leave a name blank to fall back to a text message.
# Params: name, booking ID, test, date, time, amount
WHATSAPP_TEMPLATE_BOOKING_REQUEST=indipath_booking_request
# Params: name, patient ID, booking ID, test, date, time, amount
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=indipath_booking_confirmed
# Params: name, booking ID, test, rejection reason
WHATSAPP_TEMPLATE_BOOKING_REJECTED=indipath_booking_rejected
# Params: name, patient ID, booking ID, receipt ID, test, amount
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=indipath_payment_received
# Params: name, patient ID, booking ID, test
WHATSAPP_TEMPLATE_REPORT_READY=indipath_report_ready
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Params: name, booking ID, test
WHATSAPP_TEMPLATE_SAMPLE_COLLECTED=indipath_sample_collected

# Approved utility templates with DOCUMENT headers (not the old text templates).
# Receipt body params: patient name, booking ID, amount
WHATSAPP_TEMPLATE_RECEIPT_DOCUMENT=
# Report body params: patient name, booking ID
WHATSAPP_TEMPLATE_REPORT_DOCUMENT=
