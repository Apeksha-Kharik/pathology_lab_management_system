PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_connection_string
# Optional: maximum time to discover a MongoDB server (milliseconds).
MONGO_CONNECTION_TIMEOUT_MS=30000
JWT_SECRET=change_this_to_a_long_random_secret

# Comma-separated frontend origins allowed by CORS (no trailing slash).
FRONTEND_URL=http://localhost:5175

# Required for real Gmail SMTP email delivery.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com

# In local development only, show the OTP in the UI if email delivery fails.
# This fallback is always disabled when NODE_ENV=production.
ALLOW_DEV_OTP=true

# Required for WhatsApp notifications after booking/payment/report events.
# Use Meta WhatsApp Cloud API credentials.
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_cloud_api_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
